# Local overrides — copy to .env.local (git-ignored) and fill in values.
# Run 'npm run seed:workers' to generate WORKER_N_EMAIL / WORKER_N_PASSWORD values.
ENV=local
API_BASE_URL=https://automationexercise.com
UI_BASE_URL=https://automationexercise.com
LOG_LEVEL=DEBUG
MAX_WORKERS=4

# Worker account credentials (one pair per Playwright worker).
# WORKER_N_EMAIL goes here; WORKER_N_PASSWORD goes in GitHub Secrets for CI.
WORKER_0_EMAIL=
WORKER_0_PASSWORD=
WORKER_1_EMAIL=
WORKER_1_PASSWORD=
WORKER_2_EMAIL=
WORKER_2_PASSWORD=
WORKER_3_EMAIL=
WORKER_3_PASSWORD=
